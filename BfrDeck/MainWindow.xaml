<Window x:Class="BfrDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BFR Deck" Height="1000" Width="600" MinWidth="600" MinHeight="640"
        Background="#0b0d1a" WindowStartupLocation="Manual">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Cap" TargetType="Button">
            <Setter Property="Foreground" Value="#a9aac3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1a1e38"/>
                                <Setter Property="Foreground" Value="#e8e6df"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CapClose" TargetType="Button" BasedOn="{StaticResource Cap}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#c42b1c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Bar" Color="#0e1124"/>
        <SolidColorBrush x:Key="Ink" Color="#ece8dc"/>
        <SolidColorBrush x:Key="Dim" Color="#a9aac3"/>
        <SolidColorBrush x:Key="Gold" Color="#f2d27a"/>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1a1e38"/>
                                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tool" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1a1e38"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolOn" TargetType="Button" BasedOn="{StaticResource Tool}">
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Custom title bar: drag anywhere on it; buttons opt in to hit-testing. -->
        <DockPanel Grid.Row="0" Background="{StaticResource Bar}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Cap}" Content="&#xE921;" ToolTip="Minimize" Click="Min_Click"/>
                <Button x:Name="BtnMax" Style="{StaticResource Cap}" Content="&#xE922;" ToolTip="Maximize" Click="Max_Click"/>
                <Button Style="{StaticResource CapClose}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,6,0">
                <Button x:Name="BtnBack" Style="{StaticResource Tool}" Content="&#x2190;" ToolTip="Back" Click="Back_Click"/>
                <Button x:Name="BtnReload" Style="{StaticResource Tool}" Content="&#x21bb;" ToolTip="Reload" Click="Reload_Click"/>
                <Button x:Name="BtnDock" Style="{StaticResource Tool}" Content="Dock" ToolTip="Snap beside the BlueStacks window" Click="Dock_Click"/>
                <Button x:Name="BtnPin" Style="{StaticResource Tool}" Content="Pin" ToolTip="Keep on top" Click="Pin_Click"/>
            </StackPanel>
            <TextBlock Text="BFR Deck" Foreground="{StaticResource Gold}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,10,0"/>
            <WrapPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </DockPanel>
        <Border Grid.Row="1" Height="0"/>
        <!-- 6 px margin left/right/bottom: the WebView child window would otherwise swallow the mouse on the
             resize borders. The window background matches the page, so the margin is invisible. -->
        <Grid x:Name="Host" Grid.Row="2" Margin="6,0,6,6"/>
    </Grid>
</Window>
